<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Validasi Data Anda"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:id="@+id/tvValNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama: -"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvValEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email: -"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvValTanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tanggal Lahir: -"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvValGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Kelamin: -"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvValUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username: -"
                android:textSize="16sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="32dp"
        android:text="Konfirmasi &amp; Selesai"
        android:backgroundTint="@color/accent" />


</LinearLayout>